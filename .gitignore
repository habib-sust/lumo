*.mobileprovision
*.provisionprofile
*.p12
*.cer

# Instruments
*.trace

# Fastlane / CI artifacts
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Coverage
*.profraw
*.profdata
coverage/
